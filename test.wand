// Basic function declaration
Incantation calculate_mana(level, bonus) {
    Riddikulus (level <= 1) {
        ExpectoPatronum bonus
    } Finite {
        ExpectoPatronum level * 10 + calculate_mana(level - 1, bonus)
    }
}

// Array initialization and index access
Accio spellbook = ["Lumos", "Expelliarmus", "Expecto Patronum"]
Lumos spellbook[1]

// Input and assignment
Accio user_name = Legilimens("Enter name: ")
Lumos "User: " + user_name

Accio mana = calculate_mana(3, 15)
Lumos mana

// Exception handling
Protego {
    Lumos spellbook[99]
} Crucio (err) {
    Lumos "Caught exception: " + err
}