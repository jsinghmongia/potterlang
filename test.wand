// Remembrall: Full-featured PotterLang showcase

// 1. First-Class Function with Recursion
Incantation calculate_mana(level, bonus) {
    Riddikulus (level <= 1) {
        ExpectoPatronum bonus
    } Finite {
        ExpectoPatronum level * 10 + calculate_mana(level - 1, bonus)
    }
}

// 2. Arrays and indexing
Accio spellbook = ["Lumos", "Expelliarmus", "Expecto Patronum"]
Lumos "Primary spell selected:"
Lumos spellbook[1]

// 3. User Input & Function execution
Accio wizard_name = Legilimens("Identify yourself, Wizard: ")
Lumos "Welcome, " + wizard_name

Accio total_mana = calculate_mana(3, 15)
Lumos "Total Mana calculated:"
Lumos total_mana

// 4. Try-Catch Protection
Protego {
    Lumos "Attempting forbidden curse access..."
    Lumos spellbook[99] // Will trigger out of bounds error
} Crucio (curse_error) {
    Lumos "Protego shield held! Intercepted error:"
    Lumos curse_error
}

Lumos "Mischief Managed."
